COLLECT_SIGNUP_SECRETS_WORDS=s3cr3t,vip

# Local dev
DJANGO_DEBUG=true
DJANGO_INTERNAL_IPS=127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# For production
# DJANGO_DEBUG=0
# A private random value, NOT the one of another environment: with it, anyone
# can forge session cookies and password reset tokens. The app refuses to start
# without one when DJANGO_DEBUG is off.
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
# DJANGO_SECRET_KEY=
# Invitation secrets grant upload permission: pick your own, these ones are
# published in the sources.
# COLLECT_SIGNUP_SECRETS_WORDS=
# DJANGO_MEDIA_ROOT=/mnt/media/uploads
# DJANGO_ALLOWED_HOSTS=collect.domain
# DJANGO_CSRF_TRUSTED_ORIGINS=https://collect.domain
# DJANGO_DATABASE_URL=pgsql://collectuser:collectuser@host:5432/collect
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_PRELOAD=1
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
# DJANGO_CSRF_COOKIE_SECURE=1
# DJANGO_SESSION_COOKIE_SECURE=1
# DJANGO_SECURE_SSL_REDIRECT=1
